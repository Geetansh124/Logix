# ===== Application =====
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL + PostGIS) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polar_expedition_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=polar_expedition_dev
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT Authentication =====
JWT_SECRET=change_me_to_a_secure_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_secure_random_string_at_least_64_chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===== Socket.io =====
SOCKET_CORS_ORIGIN=http://localhost:5173

# ===== Logging =====
LOG_LEVEL=debug
